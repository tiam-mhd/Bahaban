# Duplicate this file as .env.local and fill values locally. Never commit a real .env file.
DATABASE_URL=postgresql://bahaban:CHANGE_ME@localhost:54320/bahaban
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
OTP_PROVIDER=mock
# Optional. Default 5242880; allowed range 1048576..10485760 bytes.
# MAX_UPLOAD_BYTES=5242880

# Required only when OTP_PROVIDER=parsgreen. Create/view it in your ParsGreen account's WebService section.
# Server-side secret: never expose it to the browser or commit a real value.
PARSGREEN_TOKEN=
